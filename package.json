{
  "name": "masteva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "pnpm content:lock",
    "start": "serve out",
    "content:check": "tsx scripts/content.ts check",
    "content:lock": "tsx scripts/content.ts check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "e2e:build": "MASTEVA_LOCALES=vi,en NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e2e next build",
    "e2e": "pnpm e2e:build && playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm content:check && pnpm build && pnpm e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.18",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.18",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zbsearch": "4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  }
}
