// Deploy Masteva lên Cloudflare Workers dạng site tĩnh (ADR-010): không có Worker script,
// chỉ phục vụ thư mục `out/` do `pnpm build` (Next.js static export) sinh ra.
// `out/_headers` (chép từ `public/_headers`) được Workers đọc để gắn header bảo mật.
{
  // Phải trùng tên project trên Cloudflare, nếu không Workers Builds báo lỗi.
  "name": "masteva",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./out",
    // Đường dẫn không có file thì trả `out/404.html` với mã 404.
    "not_found_handling": "404-page",
    // `vi/roadmaps/java.html` phục vụ ở `/vi/roadmaps/java`, thư mục có `index.html` thì có dấu `/` cuối.
    "html_handling": "auto-trailing-slash"
  }
}
