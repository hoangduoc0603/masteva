{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "serve",
        "design",
        "-l",
        "4400",
        "--no-clipboard"
      ],
      "port": 4400
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "serve",
        "out",
        "-l",
        "4401",
        "--no-clipboard"
      ],
      "port": 4401
    },
    {
      "name": "workers",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "wrangler@latest",
        "dev",
        "--port",
        "8799",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8799
    }
  ]
}
